# Variables d'environnement du projet (toutes optionnelles).
# Copier en .env ou les exporter dans le terminal. Ne jamais mettre de secret dans ce fichier.

# --- Google Cloud ---
# Projet GCP. Par défaut : le projet configuré avec `gcloud config set project`.
GCP_PROJECT_ID=

# --- Interface ---
# local : lit data/raw et data/scores ; bigquery : lit les tables BigQuery.
APP_SOURCE=local

# --- Agent IA ---
# vertex : Gemini sur Vertex AI ; simule : rédacteur hors ligne, sans appel réseau.
AGENT_LLM=vertex
GEMINI_MODEL=gemini-3.5-flash
VERTEX_LOCATION=global
AGENT_MAX_TOKENS=8192

# --- Recherche dans la base de connaissances (RAG) ---
# vertex : embeddings Vertex AI ; local : TF-IDF, sans appel réseau.
RAG_MOTEUR=vertex
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_LOCATION=europe-west1
